{
  "//": "Copia este archivo como appsettings.Local.json y deja SOLO la linea que corresponda a tu SQL Server.",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=VentaComponentes;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  },
  "Ejemplos": {
    "SQL Server instancia por defecto": "Server=localhost;Database=VentaComponentes;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "SQL Server Express": "Server=.\\SQLEXPRESS;Database=VentaComponentes;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "LocalDB (viene con Visual Studio)": "Server=(localdb)\\MSSQLLocalDB;Database=VentaComponentes;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True;",
    "Con usuario y clave (ej. Docker)": "Server=localhost,1433;Database=VentaComponentes;User Id=sa;Password=TU_CLAVE;TrustServerCertificate=True;MultipleActiveResultSets=True;"
  }
}
